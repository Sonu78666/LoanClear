GROQ_API_KEY=your-groq-key
PORT=3001
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_PER_WINDOW=5
DAILY_LIMIT_PER_IP=30
MAX_MESSAGES_PER_SESSION=10
MAX_INPUT_CHARS=400
MAX_TOKENS_PER_REPLY=900
ALLOWED_ORIGIN=http://localhost:5500
# Postgres connection string for the /api/subscribe email list. On Railway,
# add a Postgres service and set this to a reference variable
# (${{<postgres-service-name>.DATABASE_URL}}). For local dev, use that same
# service's public/proxy connection string (internal *.railway.internal
# hostnames only resolve from inside Railway's network).
DATABASE_URL=postgresql://user:password@host:5432/dbname
